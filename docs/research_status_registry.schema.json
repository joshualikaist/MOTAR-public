{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "status_semantics",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "COMPLETED",
        "PLANNED",
        "BLOCKED",
        "NOT_TESTED",
        "ARCHIVED_WITHDRAWN"
      ],
      "patternProperties": {
        "^(COMPLETED|PLANNED|BLOCKED|NOT_TESTED|ARCHIVED_WITHDRAWN)$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "line_style",
            "description"
          ],
          "properties": {
            "line_style": {
              "enum": [
                "solid",
                "dashed",
                "double",
                "dotted",
                "dash-dot"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/component"
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "lifecycle_status",
        "evidence_status",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_status": {
          "enum": [
            "COMPLETED",
            "PLANNED",
            "BLOCKED",
            "NOT_TESTED",
            "ARCHIVED_WITHDRAWN"
          ]
        },
        "evidence_status": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
