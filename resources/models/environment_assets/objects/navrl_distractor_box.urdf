<?xml version='1.0' encoding='UTF-8'?>
<!-- NavRL appearance distractor: box, 0.30 x 0.30 x 0.30 m.

     Target-scale (the target body is a 0.28 x 0.28 x 0.12 m box, navrl_target_drone.urdf) but a
     different aspect ratio, so it is the "same size, wrong shape" arm of the distractor axis.
     Static (fix_base_link) but physically real: the collision box is identical to the visual box,
     so the LiDAR sees it and the drone can hit it.  The renderer paints it the nominal target
     colour (navrl_detector.py).

     Inertia: solid cube, m = 1.0 kg, a = 0.30 m, I = m (a^2 + a^2) / 12 = 0.015 kg m^2. -->
<robot name="navrl_distractor_box">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <inertia ixx="0.015" ixy="0.0" ixz="0.0" iyy="0.015" iyz="0.0" izz="0.015"/>
    </inertial>
    <visual name="base_link_visual">
      <geometry>
        <box size="0.30 0.30 0.30"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="DistractorRed">
        <color rgba="0.88 0.08 0.045 1.0"/>
      </material>
    </visual>
    <collision name="base_link_collision">
      <geometry>
        <box size="0.30 0.30 0.30"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
</robot>
