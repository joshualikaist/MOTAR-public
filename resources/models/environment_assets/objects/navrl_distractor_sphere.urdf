<?xml version='1.0' encoding='UTF-8'?>
<!-- NavRL appearance distractor: sphere, radius 0.15 m.

     Deliberately the SAME radius as the detector's target proxy
     (vision.camera_target_radius = 0.15, navrl_task_config.py), so an apparent-size-versus-range
     consistency check cannot separate it from the target.  Static (fix_base_link) but physically
     real: the collision sphere is identical to the visual sphere, so the LiDAR sees it and the
     drone can hit it.  The renderer paints it the nominal target colour (navrl_detector.py).

     Inertia: solid sphere, m = 0.5 kg, I = 2/5 m r^2 = 0.0045 kg m^2 about every axis. -->
<robot name="navrl_distractor_sphere">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0045" ixy="0.0" ixz="0.0" iyy="0.0045" iyz="0.0" izz="0.0045"/>
    </inertial>
    <visual name="base_link_visual">
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="DistractorRed">
        <color rgba="0.88 0.08 0.045 1.0"/>
      </material>
    </visual>
    <collision name="base_link_collision">
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
</robot>
