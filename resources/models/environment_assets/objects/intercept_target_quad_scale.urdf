<?xml version='1.0' encoding='UTF-8'?>
<!-- Collision sphere radius matches resources/robots/quad/quad.urdf base_link collision sphere (R=0.05 m). -->
<robot name="intercept_target_quad_scale">
  <link name="base_link">
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual name="base_link_visual">
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="TargetRed">
        <color rgba="0.9 0.2 0.2 0.85"/>
      </material>
    </visual>
    <collision name="base_link_collision">
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
  </link>
</robot>
